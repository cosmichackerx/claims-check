{
  "claims": [
    {
      "id": "unit tests",
      "file": "README.md",
      "regex": "(\\d+)\\+ unit tests",
      "match": "at-least",
      "max_gap": 15,
      "expect": {
        "command": "python -m pytest --collect-only -q",
        "regex": "^(\\d+) tests? collected"
      }
    },
    {
      "id": "version pin in the README",
      "file": "README.md",
      "regex": "claims-check@v([0-9.]+)",
      "expect": {
        "file": "pyproject.toml",
        "regex": "^version = \"([0-9.]+)\""
      }
    },
    {
      "id": "reusable release gate pins this version",
      "file": ".github/workflows/reusable-release-gate.yml",
      "regex": "default: \"v([0-9.]+)\"",
      "expect": {
        "file": "pyproject.toml",
        "regex": "^version = \"([0-9.]+)\""
      }
    },
    {
      "id": "reusable latest-tag check pins this version",
      "file": ".github/workflows/reusable-latest-tag.yml",
      "regex": "default: \"v([0-9.]+)\"",
      "expect": {
        "file": "pyproject.toml",
        "regex": "^version = \"([0-9.]+)\""
      }
    },
    {
      "id": "CI test of the reusable gate uses the current version as its tag",
      "file": ".github/workflows/ci.yml",
      "regex": "tag: v([0-9.]+)",
      "expect": {
        "file": "pyproject.toml",
        "regex": "^version = \"([0-9.]+)\""
      }
    }
  ]
}
